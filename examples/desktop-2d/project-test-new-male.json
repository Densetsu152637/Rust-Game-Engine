{
  "schema": 1,
  "rust": { "manifest": "Cargo.toml" },
  "name": "Desktop 2D synthetic lab",
  "startup_scene": "scenes/test-new-male.scene.json",
  "assets": [
    {
      "id": "asset:player",
      "path": "src/player.rs",
      "kind": "script"
    },
    {
      "id": "asset:controller",
      "path": "src/controller.rs",
      "kind": "script"
    },
    {
      "id": "asset:progression",
      "path": "src/progression.rs",
      "kind": "script"
    },
    {
      "id": "asset:bindings",
      "path": "src/bindings.rs",
      "kind": "script"
    },
    {
      "id": "asset:sprites",
      "path": "assets/sprites.png",
      "kind": "texture"
    },
    {
      "id": "asset:font-texture",
      "path": "assets/font.png",
      "kind": "texture"
    },
    {
      "id": "asset:font",
      "path": "assets/font.json",
      "kind": "font"
    },
    {
      "id": "asset:cue",
      "path": "assets/cue.wav",
      "kind": "audio"
    },
    {
      "id": "asset:loop",
      "path": "assets/loop.wav",
      "kind": "audio"
    },
    {
      "id": "asset:room-a",
      "path": "scenes/room-a.scene.json",
      "kind": "scene"
    },
    {
      "id": "asset:room-b",
      "path": "scenes/room-b.scene.json",
      "kind": "scene"
    },
    {
      "id": "asset:test-new-male",
      "path": "src/test-new-male.rs",
      "kind": "script"
    },
    {
      "id": "asset:test-new-female",
      "path": "src/test-new-female.rs",
      "kind": "script"
    },
    {
      "id": "asset:test-restore-male",
      "path": "src/test-restore-male.rs",
      "kind": "script"
    },
    {
      "id": "asset:test-restore-female",
      "path": "src/test-restore-female.rs",
      "kind": "script"
    }
  ],
  "inputBindings": {
    "move_left": [
      "Key:A",
      "Key:Left",
      "Gamepad:LeftXNegative"
    ],
    "move_right": [
      "Key:D",
      "Key:Right",
      "Gamepad:LeftXPositive"
    ],
    "move_up": [
      "Key:W",
      "Key:Up",
      "Gamepad:LeftYNegative"
    ],
    "move_down": [
      "Key:S",
      "Key:Down",
      "Gamepad:LeftYPositive"
    ],
    "interact": [
      "Key:E",
      "Gamepad:A"
    ],
    "journal": [
      "Key:J",
      "Gamepad:Y"
    ],
    "rest": [
      "Key:R",
      "Gamepad:X"
    ],
    "load": [
      "Key:L",
      "Gamepad:Back"
    ],
    "new_game": [
      "Key:N"
    ],
    "choose_variant": [
      "Key:P"
    ],
    "scene_demo": [
      "Key:H"
    ],
    "defeat_demo": [
      "Key:B"
    ],
    "remap": [
      "Key:F"
    ],
    "mute": [
      "Key:M"
    ],
    "ui_confirm": [
      "Key:Enter",
      "Gamepad:A"
    ],
    "ui_back": [
      "Key:Escape",
      "Gamepad:B"
    ],
    "ui_up": [
      "Key:Up",
      "Gamepad:DpadUp",
      "Mouse:WheelUp"
    ],
    "ui_down": [
      "Key:Down",
      "Gamepad:DpadDown",
      "Mouse:WheelDown"
    ],
    "ui_click": [
      "Mouse:Left"
    ],
    "story_demo": [
      "Key:T"
    ]
  }
}
